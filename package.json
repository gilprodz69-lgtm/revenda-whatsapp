{
  "name": "revenda-whatsapp",
  "version": "1.0.3",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/admin"
  ],
  "engines": {
    "node": ">=22.22.0 <23"
  },
  "overrides": {
    "vite": "7.3.7",
    "effect": "3.20.0",
    "deepmerge-ts": "8.0.2"
  },
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test -w apps/api",
    "test:integration": "npm run test:integration -w apps/api",
    "dev:api": "npm run dev -w apps/api",
    "dev:admin": "npm run dev -w apps/admin",
    "db:generate": "npm run db:generate -w apps/api",
    "db:migrate": "npm run db:migrate -w apps/api",
    "test:e2e": "npm run test:e2e -w apps/admin",
    "test:runtime": "node scripts/runtime-smoke.cjs",
    "format": "prettier --write apps/**/*.{ts,tsx,json,css} package.json compose.yaml .github/workflows/*.yaml",
    "format:check": "prettier --check apps/**/*.{ts,tsx,json,css} package.json compose.yaml .github/workflows/*.yaml"
  },
  "devDependencies": {
    "prettier": "3.6.2"
  }
}
