# Instalador gera as senhas e chaves; nunca publique o .env preenchido.
COMPOSE_PROJECT_NAME=revenda
APP_DOMAIN=loja.example.com
ACME_EMAIL=operacao@example.com
APP_ORIGIN=https://loja.example.com
PUBLIC_API_URL=https://loja.example.com
NODE_ENV=production
TRUST_PROXY=1
POSTGRES_PASSWORD=replace_with_random_hex
DB_PASSWORD=replace_with_random_hex
EVOLUTION_DB_PASSWORD=replace_with_random_hex
REDIS_PASSWORD=replace_with_random_hex
DATABASE_URL=postgresql://app:replace_with_random_hex@postgres:5432/revenda?schema=public
REDIS_URL=redis://:replace_with_random_hex@redis:6379/0
ENCRYPTION_KEY=replace_with_64_hex_characters
WEBHOOK_SECRET=replace_with_random_hex_minimum_32_characters
EVOLUTION_API_KEY=replace_with_random_hex
EVOLUTION_URL=http://evolution:8080
PARTNER_URL=https://ggsoma.store/api/partner/v1
PARTNER_API_KEY=
PARTNER_REQUESTS_PER_MINUTE=60
PARTNER_ORDERS_PER_MINUTE=10
PIX_GATEWAY=disabled
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
ADMIN_EMAIL=admin@example.com
BACKUP_RETENTION_DAYS=14
